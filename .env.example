# Copy to .env and fill in. Real environment variables always win over
# this file. config/settings.py reads only the variables listed here.

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Reverse-proxy / HTTPS hardening ---
# All optional. Every one defaults to the dev-safe value shown when unset, so
# local `runserver` needs none of them. Turn them on only for a deployment
# that sits behind Nginx with TLS (see deploy/nginx-aegisflow.conf).
#
# Comma-separated scheme://host origins trusted for cross-origin POSTs.
# Set to the real site origin in production, e.g. https://aegisflow.vincypros.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Trust Nginx's X-Forwarded-Proto header (set True behind the proxy).
DJANGO_SECURE_PROXY_SSL_HEADER=False
# Send session / CSRF cookies over HTTPS only (True in production).
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Redirect plain HTTP to HTTPS at the Django layer (True in production).
DJANGO_SECURE_SSL_REDIRECT=False
# HTTP Strict Transport Security max-age in seconds. 0 = off. Keep 0 until
# the site is proven stable over HTTPS, then raise gradually (e.g. 3600 ->
# 31536000).
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Branding (shown in the UI and Django admin) ---
BRAND_NAME=AegisFlow AI
BRAND_TAGLINE=AI-powered cyber resilience workflow for alerts, risks, playbooks, and reports.

# --- Anthropic / AI ---
# ANTHROPIC_API_KEY is required for any AI feature. Without it the app
# still runs; AI actions fail gracefully with a "not configured" message.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- AI safety layers (apps/ai_core) ---
AI_SANITIZER_ENABLED=True
AI_RATE_LIMIT_ENABLED=True
AI_RATE_LIMIT_GLOBAL_PER_HOUR=40
AI_RATE_LIMIT_ENDPOINT_PER_MINUTE=8
# Hourly-budget calls the background endpoint-triage scan leaves free for
# interactive AI features (analyst, App Assistant). 0 disables.
AI_TRIAGE_INTERACTIVE_RESERVE=15

# --- Database ---
# Postgres is used only if ALL five DATABASE_* variables are set;
# otherwise the app falls back to SQLite at db.sqlite3. Leave these
# blank/commented for local SQLite development.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# --- Private file storage (relative to the project root) ---
PRIVATE_UPLOAD_ROOT=private_uploads
PRIVATE_EXPORT_ROOT=private_exports
